# .env.sample — copy to .env and fill in values
# All variables listed here are required unless marked [optional]

# --- Application (ADR-0005 — single-user Google OAuth) ---

# Random signing secret for the session/JWT cookie. Generate with:
#   openssl rand -base64 33
AUTH_SECRET=

# Public base URL of the deployment (used by Auth.js to build the OAuth
# callback URL). Not needed for local dev on localhost.
AUTH_URL=

# Google OAuth Client ID/Secret from Google Cloud Console (ADR-0005 §Setup).
CLIENT_ID=
CLIENT_PASSWORD=

# The only Google account allowed to sign in. An unset value denies
# everyone — see the fail-closed comment in src/auth.ts.
ALLOWED_GOOGLE_EMAIL=

# Neon Postgres pooled connection string (user-provisioned; see ADR-0001)
DATABASE_URL=

# Bearer token for POST /api/jobs/daily-briefing (ADR-0003). High-entropy random
# value. This is the ONLY guard on the daily job endpoint — keep it secret, or
# anyone who finds the URL can burn the daily Gemini/provider quota.
CRON_SECRET=

# Which Gemini model generates the daily briefing (ADR-0003). Verify this id
# against Google's current Gemini API model catalog before relying on it — see
# spec 0001 § Environment for the explicit unverified-default caveat.
GEMINI_MODEL=gemini-3.6-flash

# [optional] Asia/Seoul — belt-and-braces; app date logic must not depend on the
# host TZ (all dates computed via a single Asia/Seoul helper regardless).
TZ=Asia/Seoul

# [optional] Daily briefing output language, default "ko" (spec 0001 § Accessibility)
BRIEFING_LANG=ko

# --- Providers (server-only, routed through src/lib/providers/gateway.ts) ---

# KRX Open API — Korean market/exchange data
KRX_API_KEY=

# DART OpenAPI — Korean corporate disclosures
DART_API_KEY=

# Bank of Korea ECOS — Korean macroeconomic indicators
ECOS_API_KEY=

# Finnhub — US market data and news
FINNHUB_API_KEY=

# FMP (Financial Modeling Prep) — US company fundamentals
FMP_API_KEY=

# Naver Search API — Korean news search (client ID)
NAVER_CLIENT_ID=

# Naver Search API — Korean news search (client secret)
NAVER_CLIENT_SECRET=

# Gemini API — news analysis and daily briefing generation (free tier, prototype)
GEMINI_API_KEY=
