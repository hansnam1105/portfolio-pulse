{
  "primitive": {
    "color": {
      "blue": { "500": "#0066cc", "600": "#0052a3", "300": "#4d9fff", "700": "#003e8a" },
      "gray": { "500": "#6c757d", "400": "#9ca3af", "600": "#495057" },
      "green": { "500": "#28a745", "300": "#34d399", "700": "#146829" },
      "amber": { "500": "#ffc107", "300": "#fbbf24", "700": "#664d03" },
      "red": { "500": "#dc3545", "300": "#f87171", "700": "#a71d2a" },
      "crimson": {
        "50": "#fdeef0",
        "200": "#f4c2c9",
        "300": "#ff6b6b",
        "600": "#c8102e",
        "700": "#9b0c23",
        "800": "#6d0819",
        "900": "#3a0f18"
      },
      "cobalt": {
        "50": "#eaf1fe",
        "200": "#bcd3f8",
        "300": "#6fa8ff",
        "600": "#0b4fcf",
        "700": "#083a99",
        "800": "#052866",
        "900": "#0b1f42"
      },
      "slate": {
        "50": "#eef1f5",
        "200": "#cbd4e0",
        "300": "#9aa8bd",
        "600": "#546376",
        "700": "#3d4857",
        "800": "#2b3442",
        "900": "#1e2532"
      },
      "neutral": { "0": "#ffffff", "50": "#f9fafb", "100": "#f2f4f7", "200": "#e5e8ee", "800": "#1c2331", "900": "#111827", "950": "#000000" },
      "ink": { "900": "#1a1a1a" }
    },
    "font": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "Fira Code, monospace"
    },
    "font-size": { "sm": "0.875rem", "base": "1rem", "lg": "1.25rem", "xl": "1.5rem" },
    "space": { "xs": "0.25rem", "sm": "0.5rem", "md": "1rem", "lg": "1.5rem", "xl": "2rem" },
    "radius": { "sm": "4px", "md": "8px", "lg": "16px" },
    "elevation": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px rgba(0, 0, 0, 0.1)",
      "lg": "0 10px 15px rgba(0, 0, 0, 0.1)"
    },
    "duration": { "fast": "150ms", "normal": "250ms", "slow": "400ms" }
  },
  "semantic": {
    "color": {
      "primary": "var(--color-blue-500)",
      "secondary": "var(--color-gray-500)",
      "success": "var(--color-green-500)",
      "warning": "var(--color-amber-500)",
      "danger": "var(--color-red-500)",
      "background": "var(--color-neutral-0)",
      "surface": "var(--color-neutral-0)",
      "surface-sunken": "var(--color-neutral-100)",
      "border": "var(--color-neutral-200)",
      "text": "var(--color-ink-900)",
      "text-muted": "var(--color-slate-600)",

      "value-up": "var(--color-crimson-600)",
      "value-up-bg": "var(--color-crimson-50)",
      "value-up-border": "var(--color-crimson-200)",
      "value-down": "var(--color-cobalt-600)",
      "value-down-bg": "var(--color-cobalt-50)",
      "value-down-border": "var(--color-cobalt-200)",
      "value-flat": "var(--color-slate-600)",
      "value-flat-bg": "var(--color-slate-50)",
      "value-flat-border": "var(--color-slate-200)",

      "stale": "var(--color-slate-600)",
      "stale-bg": "var(--color-slate-50)",
      "stale-border": "var(--color-slate-200)",
      "estimated": "var(--color-slate-600)",
      "estimated-bg": "var(--color-slate-50)",
      "estimated-border": "var(--color-slate-200)"
    },
    "typography": {
      "font-family": {
        "sans": "var(--font-sans)",
        "mono": "var(--font-mono)"
      },
      "font-size": {
        "sm": "var(--font-size-sm)",
        "base": "var(--font-size-base)",
        "lg": "var(--font-size-lg)",
        "xl": "var(--font-size-xl)"
      }
    },
    "spacing": {
      "xs": "var(--space-xs)",
      "sm": "var(--space-sm)",
      "md": "var(--space-md)",
      "lg": "var(--space-lg)",
      "xl": "var(--space-xl)"
    },
    "border-radius": {
      "sm": "var(--radius-sm)",
      "md": "var(--radius-md)",
      "lg": "var(--radius-lg)"
    },
    "shadow": {
      "sm": "var(--elevation-sm)",
      "md": "var(--elevation-md)",
      "lg": "var(--elevation-lg)"
    },
    "motion": {
      "duration-fast": "var(--duration-fast)",
      "duration-normal": "var(--duration-normal)",
      "duration-slow": "var(--duration-slow)"
    },
    "target": {
      "size": "2.75rem"
    },
    "focus": {
      "ring": "2px solid var(--color-primary)",
      "ring-offset": "2px"
    }
  },
  "themes": {
    "dark": {
      "color": {
        "primary": "var(--color-blue-300)",
        "secondary": "var(--color-gray-400)",
        "success": "var(--color-green-300)",
        "warning": "var(--color-amber-300)",
        "danger": "var(--color-red-300)",
        "background": "var(--color-neutral-900)",
        "surface": "var(--color-neutral-800)",
        "surface-sunken": "var(--color-neutral-900)",
        "border": "var(--color-slate-800)",
        "text": "var(--color-neutral-50)",
        "text-muted": "var(--color-slate-300)",

        "value-up": "var(--color-crimson-300)",
        "value-up-bg": "var(--color-crimson-900)",
        "value-up-border": "var(--color-crimson-800)",
        "value-down": "var(--color-cobalt-300)",
        "value-down-bg": "var(--color-cobalt-900)",
        "value-down-border": "var(--color-cobalt-800)",
        "value-flat": "var(--color-slate-300)",
        "value-flat-bg": "var(--color-slate-900)",
        "value-flat-border": "var(--color-slate-800)",

        "stale": "var(--color-slate-300)",
        "stale-bg": "var(--color-slate-900)",
        "stale-border": "var(--color-slate-800)",
        "estimated": "var(--color-slate-300)",
        "estimated-bg": "var(--color-slate-900)",
        "estimated-border": "var(--color-slate-800)"
      },
      "shadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
        "md": "0 4px 6px rgba(0, 0, 0, 0.4)",
        "lg": "0 10px 15px rgba(0, 0, 0, 0.5)"
      }
    },
    "high-contrast": {
      "color": {
        "primary": "var(--color-blue-700)",
        "secondary": "var(--color-gray-600)",
        "success": "var(--color-green-700)",
        "warning": "var(--color-amber-700)",
        "danger": "var(--color-red-700)",
        "background": "var(--color-neutral-0)",
        "surface": "var(--color-neutral-0)",
        "surface-sunken": "var(--color-neutral-50)",
        "border": "var(--color-slate-700)",
        "text": "var(--color-neutral-950)",
        "text-muted": "var(--color-slate-700)",

        "value-up": "var(--color-crimson-700)",
        "value-up-bg": "var(--color-neutral-0)",
        "value-up-border": "var(--color-crimson-700)",
        "value-down": "var(--color-cobalt-700)",
        "value-down-bg": "var(--color-neutral-0)",
        "value-down-border": "var(--color-cobalt-700)",
        "value-flat": "var(--color-slate-700)",
        "value-flat-bg": "var(--color-neutral-0)",
        "value-flat-border": "var(--color-slate-700)",

        "stale": "var(--color-slate-700)",
        "stale-bg": "var(--color-neutral-0)",
        "stale-border": "var(--color-slate-700)",
        "estimated": "var(--color-slate-700)",
        "estimated-bg": "var(--color-neutral-0)",
        "estimated-border": "var(--color-slate-700)"
      }
    }
  }
}
